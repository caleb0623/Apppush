# Copy to .env (or run `npm run setup:env`, which generates the CHANGE_ME values).
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# MySQL 8 connection strings. The test URL's database name MUST end in _test.
DATABASE_URL="mysql://apppush:CHANGE_ME_DB_PASSWORD@localhost:3306/apppush"
DATABASE_URL_TEST="mysql://apppush:CHANGE_ME_DB_PASSWORD@localhost:3306/apppush_test"

# Secrets: at least 32 characters each.
JWT_SECRET=CHANGE_ME_JWT_SECRET
JWT_EXPIRES_IN=8h
# HMAC key mixed into stored Master Secret hashes. Changing it invalidates all credentials.
CREDENTIAL_PEPPER=CHANGE_ME_CREDENTIAL_PEPPER

# Admin account created by the seed script.
SEED_ADMIN_EMAIL=admin@apppush.local
SEED_ADMIN_PASSWORD=CHANGE_ME_SEED_ADMIN_PASSWORD

# Background worker
WORKER_POLL_INTERVAL_MS=2000
WORKER_STALE_LOCK_MS=120000
WORKER_MAX_ATTEMPTS=3

# Testing-environment request limit (requests per second, per environment)
TESTING_ENV_QPS=10

# Firebase Cloud Messaging. Leave both unset and real devices cannot be reached;
# everything else still works. See docs/firebase-setup.md.
# Path to the service account key, relative to backend/. backend/secrets/ is git-ignored.
# FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json
# Or the key itself, as raw JSON or base64, for hosts that cannot store a file.
# FIREBASE_SERVICE_ACCOUNT_JSON=

# data: the app is woken for every message and reports receipt (recommended).
# hybrid: also sends a notification block, for phones that kill background apps.
#         Android then shows it without the app, so only the click is reported.
FCM_PAYLOAD_MODE=data
# How long FCM keeps trying an offline phone, in seconds (default one day).
FCM_TTL_SECONDS=86400
FCM_TIMEOUT_MS=15000
